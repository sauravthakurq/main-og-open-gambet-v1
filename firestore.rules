rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isGamePlayer(gameData) {
      return request.auth.uid == gameData.whiteUid || 
             request.auth.uid == gameData.blackUid;
    }

    function isGameCompleted(gameData) {
      return gameData.status == 'completed' || gameData.status == 'aborted';
    }

    function isCorrectTurn(gameData) {
      let isWhite = request.auth.uid == gameData.whiteUid;
      let isBlack = request.auth.uid == gameData.blackUid;
      return (isWhite && gameData.turn == 'w') || (isBlack && gameData.turn == 'b');
    }

    // ─── Users Collection ─────────────────────────────────────
    match /users/{uid} {
      // Anyone can read user profiles (for leaderboard, opponent info)
      allow read: if isAuthenticated();
      // Only the user themselves can create/update their profile
      allow create: if isAuthenticated() && isOwner(uid);
      allow update: if isAuthenticated() && isOwner(uid);
      // Nobody can delete profiles
      allow delete: if false;
    }

    // ─── Games Collection ─────────────────────────────────────
    match /games/{gameId} {
      // Players and spectators can read
      allow read: if isAuthenticated();

      // Creating a game: must be authenticated, and you must be one of the players
      allow create: if isAuthenticated() && 
        (request.resource.data.whiteUid == request.auth.uid || 
         request.resource.data.blackUid == request.auth.uid);

      // Updating a game: must be a player
      // Additional rule: if updating fen/turn (making a move), must be the correct turn
      allow update: if isAuthenticated() && 
        isGamePlayer(resource.data) &&
        !isGameCompleted(resource.data);

      // Nobody can delete games
      allow delete: if false;

      // ─── Moves Subcollection ─────────────────────────────────
      match /moves/{moveId} {
        allow read: if isAuthenticated();
        // Only the player whose turn it is can add moves
        allow create: if isAuthenticated() && 
          isGamePlayer(get(/databases/$(database)/documents/games/$(gameId)).data) &&
          request.resource.data.playerUid == request.auth.uid;
        allow update, delete: if false; // Moves are immutable
      }

      // ─── Chat Subcollection ──────────────────────────────────
      match /chat/{msgId} {
        allow read: if isAuthenticated();
        // Only players (and in future, spectators) can write chat
        allow create: if isAuthenticated() && 
          isGamePlayer(get(/databases/$(database)/documents/games/$(gameId)).data) &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ─── Rooms Collection ─────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      // Host creates the room
      allow create: if isAuthenticated() && 
        request.resource.data.hostUid == request.auth.uid;
      // Host can update anything; guest can only update their own join fields
      allow update: if isAuthenticated() && (
        resource.data.hostUid == request.auth.uid ||
        (resource.data.guestUid == null && request.resource.data.guestUid == request.auth.uid)
      );
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }

    // ─── Matchmaking Collection ───────────────────────────────
    match /matchmaking/{entryId} {
      allow read: if isAuthenticated();
      // Each user can only create their own matchmaking entry
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid;
      // Allow status updates (e.g., marking as 'matched')
      allow update: if isAuthenticated();
      // Users can delete their own entries (cancel search)
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ─── Notifications Collection ─────────────────────────────
    match /notifications/{uid}/{notifId} {
      // Only the recipient can read their notifications
      allow read: if isAuthenticated() && isOwner(uid);
      // System/other users can write notifications to anyone
      allow create: if isAuthenticated();
      // Recipient can update (mark as read) or delete
      allow update, delete: if isAuthenticated() && isOwner(uid);
    }
  }
}
